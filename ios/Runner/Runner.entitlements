<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the CloserWidget extension (widget data and cover images). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.closerapp.closer</string>
	</array>
	<!-- Push notifications. Codemagic switches this to "production" for release builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
