# Copy to `.env` (git-ignored) and run:
#   flutter run --dart-define-from-file=.env
# Only CLIENT-SAFE values belong here. Never put the Supabase service-role key,
# store credentials, APNs/FCM keys or signing keys in this file.

# Supabase project URL and publishable (anon) key — Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Set to true only after the provider is enabled in Supabase → Authentication → Providers
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false

# Published legal pages (https only) and support contact
PRIVACY_POLICY_URL=
TERMS_URL=
SUPPORT_EMAIL=

# Auth callback deep link (must also be in Supabase → Authentication → URL Configuration → Redirect URLs)
AUTH_REDIRECT_URL=com.closerapp.closer://auth-callback
