<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable from 2x2 upwards. No periodic updates: the app pushes fresh data
     when something changes, so the widget never polls or drains the battery. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.closerapp.closer.widget.CloserWidgetConfigureActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_closer"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_closer"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
